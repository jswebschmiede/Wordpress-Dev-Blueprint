# Local WordPress theme sync. Copy this file to .env (gitignored).
#
# WSL path of the Local site's wp-content directory.
# Windows: J:\Local Sites\my-site\app\public\wp-content
# WSL:     /mnt/j/Local Sites/my-site/app/public/wp-content
WP_CONTENT_PATH=

# Theme slug for `pnpm run rename:theme` and for the folder under wp-content/themes/.
# Uncomment THEME_SLUG before that script. THEME_SYNC_SLUG is an alias.
# The script reads this value. It does not need a slug argument.
# Leave unset and theme sync uses the default in node_scripts/sync-theme.js (boilerplate-theme).
# `pnpm run sync:theme --slug=<slug>` overrides the slug for that sync only.
# `pnpm run rename:theme` updates that default and these commented examples.
# A value in .env or .env.local wins over the script default. The script does not edit .env.
# THEME_SLUG=boilerplate-theme
# THEME_SYNC_SLUG=boilerplate-theme

# Company for `pnpm run rename:theme` (kebab-case or PascalCase).
# Uncomment THEME_COMPANY before that script. It does not need a --company argument.
# THEME_COMPANY=CompanyName

# Optional full destination. When set, the contents of theme/ are copied here
# and WP_CONTENT_PATH + slug are not used.
# THEME_SYNC_TARGET=/mnt/j/Local Sites/my-site/app/public/wp-content/themes/boilerplate-theme

# PLUGIN_SLUGS=
# Build, Watch und Sync. Leer oder auskommentiert = alles drei aus.
# PLUGIN_SLUGS=boilerplate-plugin,scf-boilerplate-plugin
