# Local WordPress theme sync. Copy this file to .env (gitignored).
#
# WSL path of the Local site's wp-content directory.
# Windows: J:\Local Sites\my-site\app\public\wp-content
# WSL:     /mnt/j/Local Sites/my-site/app/public/wp-content
WP_CONTENT_PATH=

# Theme slug for rename-theme.js and for the folder under wp-content/themes/.
# CLI <slug> / --slug overrides this. THEME_SYNC_SLUG is an alias of THEME_SLUG.
# Leave unset to use the default in node_scripts/sync-theme.js (boilerplate-theme).
# rename-theme.js updates that default and these commented examples.
# A value in .env or .env.local wins over the script default.
# THEME_SLUG=boilerplate-theme
# THEME_SYNC_SLUG=boilerplate-theme

# Company name for rename-theme.js (kebab-case or PascalCase). --company overrides this.
# THEME_COMPANY=CompanyName

# Optional full destination. When set, the contents of theme/ are copied here
# and WP_CONTENT_PATH + slug are not used.
# THEME_SYNC_TARGET=/mnt/j/Local Sites/my-site/app/public/wp-content/themes/boilerplate-theme

# PLUGIN_SLUGS=
# Build, Watch und Sync. Leer oder auskommentiert = alles drei aus.
# PLUGIN_SLUGS=boilerplate-plugin,scf-boilerplate-plugin
