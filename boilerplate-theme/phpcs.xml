<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 name="MVG Aktuell"
		 xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">
	<description>A set of rules to check for a custom WordPress theme</description>
	<!-- Based on the `phpcs.xml.dist.sample` file from the WordPress Coding Standards. -->

	<arg value="ps" />

	<!-- Show colors in CLI output. -->
	<arg name="colors" />

	<!-- Check up to 8 files simultaneously. -->
	<arg name="parallel"
		 value="8" />

	<!-- Check PHP files only. JavaScript and CSS files are checked separately. -->
	<arg name="extensions"
		 value="php" />

	<!-- Projekt-Ordner scannen -->
	<file>.</file>

	<!-- Typische Ordner ausschließen -->
	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>theme/vendor/*</exclude-pattern>
	<exclude-pattern>plugins/*/vendor/*</exclude-pattern>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain"
					  type="array">
				<element value="boilerplate-theme" />
				<element value="boilerplate-plugin" />
			</property>
		</properties>
	</rule>

	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName" />
	</rule>

	<rule ref="Squiz.Commenting.FunctionComment.Missing" />

	<!-- Typed properties and parameters make @var comments redundant. -->
	<rule ref="Squiz.Commenting.VariableComment.MissingVar">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- WordPress hooks often require unused parameters in their signature. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.FoundAfterLastUsed">
		<exclude-pattern>*</exclude-pattern>
	</rule>
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter.Found">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- Short ternaries are acceptable in modern PHP. -->
	<rule ref="Universal.Operators.DisallowShortTernary.Found">
		<exclude-pattern>*</exclude-pattern>
	</rule>

	<!-- Reduce false positives with typed exceptions and IDE analysis. -->
	<rule ref="Squiz.Commenting.FunctionCommentThrowTag.WrongNumber">
		<exclude-pattern>*</exclude-pattern>
	</rule>
</ruleset>