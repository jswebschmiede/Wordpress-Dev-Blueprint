{
    "$schema": "https://json.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "development:tailwind:frontend": "pnpm exec postcss ./tailwind.css -o ./theme/style.css --verbose",
        "development:tailwind:editor": "cross-env _TW_TARGET=editor pnpm exec postcss ./tailwind.css -o ./theme/style-editor.css",
        "development:tailwind:intellisense": "cross-env _TW_TARGET=intellisense pnpm exec postcss ./tailwind.css -o ./tailwind-intellisense.css",
        "development:esbuild": "pnpm exec esbuild ./javascript/script.js ./javascript/block-editor.js --target=esnext --bundle --loader:.js=jsx --outdir=./theme/js --out-extension:.js=.min.js",
        "development:esbuild:blocks": "node node_scripts/build-blocks.js",
        "development:esbuild:block-views": "node node_scripts/build-block-views.js",
        "development:plugins": "node node_scripts/run-plugin-builds.js",
        "development:copy-blocks": "node node_scripts/copy-blocks.js",
        "development": "run-p --npm-path pnpm \"development:**\" && pnpm run sync:theme --optional && pnpm run sync:plugins --optional",
        "dev": "pnpm run development",
        "sync:theme": "node node_scripts/sync-theme.js",
        "sync:plugin": "node node_scripts/sync-plugin.js",
        "sync:plugins": "node node_scripts/sync-plugin.js",
        "watch:tailwind:frontend": "pnpm exec postcss ./tailwind.css -o ./theme/style.css --verbose --watch",
        "watch:tailwind:editor": "cross-env _TW_TARGET=editor pnpm exec postcss ./tailwind.css -o ./theme/style-editor.css --watch",
        "watch:tailwind:intellisense": "cross-env _TW_TARGET=intellisense pnpm exec postcss ./tailwind.css -o ./tailwind-intellisense.css --watch",
        "watch:esbuild": "pnpm exec esbuild ./javascript/script.js ./javascript/block-editor.js --target=esnext --bundle --loader:.js=jsx --outdir=./theme/js --out-extension:.js=.min.js --watch",
        "watch:esbuild:blocks": "node node_scripts/build-blocks.js --watch",
        "watch:esbuild:block-views": "node node_scripts/build-block-views.js --watch",
        "watch:plugins": "node node_scripts/run-plugin-builds.js --watch",
        "watch:copy-blocks": "pnpm run development:copy-blocks",
        "watch:sync:theme": "pnpm run sync:theme --watch --optional",
        "watch:sync:plugins": "pnpm run sync:plugins --watch --optional",
        "watch": "run-p --npm-path pnpm \"watch:**\"",
        "lint:eslint": "pnpm exec eslint",
        "lint:prettier": "pnpm exec prettier --check .",
        "lint": "run-p --npm-path pnpm \"lint:*\"",
        "lint-fix:eslint": "pnpm exec eslint --fix",
        "lint-fix:prettier": "pnpm exec prettier --write .",
        "lint-fix": "run-p --npm-path pnpm \"lint-fix:*\"",
        "production:tailwind:frontend": "cross-env _TW_ENV=production pnpm run development:tailwind:frontend",
        "production:tailwind:editor": "cross-env _TW_ENV=production pnpm run development:tailwind:editor",
        "production:esbuild": "pnpm exec esbuild ./javascript/script.js ./javascript/block-editor.js --target=esnext --bundle --loader:.js=jsx --outdir=./theme/js --out-extension:.js=.min.js --minify",
        "production:esbuild:blocks": "node node_scripts/build-blocks.js --minify",
        "production:esbuild:block-views": "node node_scripts/build-block-views.js --minify",
        "production:esbuild:plugins": "node node_scripts/run-plugin-builds.js --minify",
        "production:copy-blocks": "pnpm run development:copy-blocks",
        "production:composer": "composer install --working-dir=theme --no-dev --optimize-autoloader",
        "production:composer:plugin:boilerplate-plugin": "composer install --working-dir=plugins/boilerplate-plugin --no-dev --optimize-autoloader",
        "production:composer:plugin:scf-boilerplate-plugin": "composer install --working-dir=plugins/scf-boilerplate-plugin --no-dev --optimize-autoloader",
        "composer:install:dev": "run-p --npm-path pnpm composer:install:dev:root composer:install:dev:theme \"composer:install:dev:plugin:*\"",
        "composer:install:dev:root": "composer install",
        "composer:install:dev:theme": "composer install --working-dir=theme",
        "composer:install:dev:plugin:boilerplate-plugin": "composer install --working-dir=plugins/boilerplate-plugin",
        "composer:install:dev:plugin:scf-boilerplate-plugin": "composer install --working-dir=plugins/scf-boilerplate-plugin",
        "composer-dev": "pnpm run composer:install:dev",
        "clean:js-sourcemaps": "node node_scripts/clean-js-sourcemaps.js",
        "clean:js-sourcemaps:plugin:boilerplate-plugin": "node node_scripts/clean-js-sourcemaps.js boilerplate-plugin",
        "clean:js-sourcemaps:plugin:scf-boilerplate-plugin": "node node_scripts/clean-js-sourcemaps.js scf-boilerplate-plugin",
        "production:assets": "run-p --npm-path pnpm --max-parallel 4 \"production:tailwind:*\" \"production:esbuild*\" \"production:copy-blocks\"",
        "production:composer-all": "run-p --npm-path pnpm --max-parallel 3 production:composer \"production:composer:plugin:*\"",
        "production": "run-s --npm-path pnpm production:assets production:composer-all && pnpm run clean:js-sourcemaps && pnpm run clean:js-sourcemaps:plugin:boilerplate-plugin && pnpm run clean:js-sourcemaps:plugin:scf-boilerplate-plugin",
        "prod": "pnpm run production",
        "zip:theme": "node node_scripts/zip.js theme boilerplate-theme",
        "zip:plugin:boilerplate-plugin": "node node_scripts/zip.js plugin boilerplate-plugin",
        "zip:plugin:scf-boilerplate-plugin": "node node_scripts/zip.js plugin scf-boilerplate-plugin",
        "zip:plugins": "run-s --npm-path pnpm \"zip:plugin:*\"",
        "zip": "run-s --npm-path pnpm zip:theme zip:plugins",
        "bundle": "run-s --npm-path pnpm production zip",
        "rename:theme": "node node_scripts/rename-theme.js",
        "rename:plugin": "node node_scripts/rename-plugin.js"
    },
    "devDependencies": {
        "@_tw/typography": "^0.5.21",
        "@eslint/js": "^9.39.4",
        "@tailwindcss/postcss": "^4.2.1",
        "@wordpress/prettier-config": "^4.41.0",
        "adm-zip": "^0.5.16",
        "archiver": "^7.0.1",
        "cross-env": "^10.1.0",
        "cssnano": "^7.1.3",
        "esbuild": "^0.28.1",
        "esbuild-plugin-external-global": "^1.0.1",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^16.5.0",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.5.8",
        "postcss-advanced-variables": "^5.0.0",
        "postcss-cli": "^11.0.1",
        "postcss-header": "^3.0.3",
        "postcss-import-ext-glob": "^2.1.1",
        "postcss-nesting": "^14.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.2.1"
    }
}
