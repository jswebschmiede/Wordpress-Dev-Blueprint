{
    "name": "companyname/boilerplate-plugin",
    "description": "Reusable WordPress plugin boilerplate",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "CompanyName\\BoilerplatePlugin\\": "includes/"
        }
    },
    "scripts": {
        "prefix-namespaces": [
            "@php ../../bin/download-strauss.php",
            "@php ../../bin/strauss.phar",
            "@composer dump-autoload"
        ],
        "prefix-namespaces:dry-run": [
            "@php ../../bin/download-strauss.php",
            "@php ../../bin/strauss.phar --dry-run"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ],
        "production": "composer install --no-dev --optimize-autoloader"
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "CompanyName\\BoilerplatePlugin\\",
            "classmap_prefix": "CompanyName_BoilerplatePlugin_",
            "packages": [
                "ramsey/uuid"
            ],
            "update_call_sites": true,
            "include_root_autoload": true,
            "delete_vendor_packages": true
        }
    },
    "config": {
        "process-timeout": 600
    },
    "authors": [
        {
            "name": "companyname",
            "homepage": "https://companyname.example"
        }
    ]
}
