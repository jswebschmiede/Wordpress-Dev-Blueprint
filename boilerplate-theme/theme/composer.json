{
    "name": "companyname/boilerplate-theme",
    "description": "Reusable WordPress theme boilerplate",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
	"require-dev": {
		"symfony/var-dumper": "^7.0"
	},
    "autoload": {
        "psr-4": {
            "CompanyName\\BoilerplateTheme\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
