{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"background": false,
			"palette": [
				{
					"slug": "background",
					"color": "#ffffff",
					"name": "Background"
				},
				{
					"slug": "foreground",
					"color": "#000000",
					"name": "Foreground"
				},
				{
					"slug": "primary",
					"color": "#D9000D",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#9C0008",
					"name": "Secondary"
				},
				{
					"slug": "dark",
					"color": "#111111",
					"name": "Dark"
				},
				{
					"slug": "light",
					"color": "#f5f5f5",
					"name": "Light"
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": false
				},
				"typography": {
					"fontWeight": false,
					"fontStyle": false,
					"textTransform": false,
					"textDecoration": false,
					"letterSpacing": false
				},
				"color": {
					"text": false,
					"background": false
				}
			},
			"core/group": {
				"color": {
					"background": true,
					"text": true
				},
				"spacing": {
					"padding": true
				}
			},
			"core/columns": {
				"spacing": {
					"padding": true,
					"blockGap": false
				}
			}
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"lineHeight": false,
			"letterSpacing": false,
			"defaultFontSizes": false,
			"fontWeight": false,
			"fontStyle": false,
			"textTransform": true,
			"textDecoration": false,
			"fontSizes": []
		},
		"shadow": {
			"defaultPresets": false
		},
		"viewport": {
			"mobile": "480px",
			"tablet": "782px"
		},
		"layout": {
			"contentSize": "60rem",
			"wideSize": "80rem"
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"customSpacingSizes": false,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"name": "Extra Small",
					"slug": "xs",
					"size": "1rem"
				},
				{
					"name": "Small",
					"slug": "sm",
					"size": "2.25rem"
				},
				{
					"name": "Medium",
					"slug": "md",
					"size": "4rem"
				},
				{
					"name": "Large",
					"slug": "lg",
					"size": "5rem"
				},
				{
					"name": "Extra Large",
					"slug": "xl",
					"size": "7rem"
				}
			]
		}
	}
}
